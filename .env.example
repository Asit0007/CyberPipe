# Copy to .env and fill in. .env is read once at process start — restart
# scheduler.py / telegram_poller.py after editing.

# Telegram bot for human-in-the-loop checkpoints and notifications.
# Get a token from @BotFather, then get your own chat id from @userinfobot.
# Both scheduler.py and telegram_poller.py run fine without these set — they
# just skip notifications/polling until filled in.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The show name written into scripts and the publish package when a job doesn't set its own.
CHANNEL_BRAND_NAME=Blast Radius

# Base URL of a running ContentPipe instance (npm run dev in that repo).
# Stages 1-3 call its /api/research, /api/plan, /api/script endpoints.
CONTENTPIPE_BASE_URL=http://localhost:3000
CONTENTPIPE_TIMEOUT_SECONDS=180

DB_PATH=pipeline.db
POLL_INTERVAL_SECONDS=60
NEEDS_INPUT_TIMEOUT_HOURS=72
MAX_STAGE_ATTEMPTS=5

# Give up on a job that has been continuously rate-limited / waiting on a busy ContentPipe this long.
MAX_WAIT_DAYS=7
# Longest gap between re-polls while ContentPipe's model providers are overloaded (its 503):
# OVERLOAD_MAX_WAIT_SECONDS=900
# A RUNNING job with no live worker is re-queued; this lease must exceed the longest stage
# (defaults to the longer of the script timeout and the ContentRender timeout, plus 600).
# RUNNING_LEASE_SECONDS=2400
# Minimum gap before re-trying a Telegram message that failed to send.
TELEGRAM_RESEND_COOLDOWN_SECONDS=300

# --- ContentRender: stages 4-6 (stills, clips + narration, the Resolve bundle) run its command line ---
# Where it is checked out, and the ABSOLUTE path of node (launchd has no PATH). Defaults: ../ContentRender, node on PATH.
# CONTENTRENDER_DIR=/Users/you/Developer/My VSC projects/My Persona/ContentRender
# CONTENTRENDER_NODE=/opt/homebrew/bin/node
# Seconds of work one call may start, and the hard ceiling on one call (the budget plus the longest single AI clip).
# CONTENTRENDER_STEP_BUDGET_SECONDS=1200
# CONTENTRENDER_TIMEOUT_SECONDS=2100
# Where the approved script is written for ContentRender (one JSON file per job). Default: ./data/briefs
# BRIEFS_DIR=./data/briefs
